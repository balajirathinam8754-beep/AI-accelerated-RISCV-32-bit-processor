class riscv_soc_driver extends uvm_driver #(riscv_soc_sequence_item);

    `uvm_component_utils(riscv_soc_driver)

    virtual riscv_soc_if vif;

    function new(
        string name = "riscv_soc_driver",
        uvm_component parent = null
    );
        super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);

        super.build_phase(phase);

        if (!uvm_config_db#(virtual riscv_soc_if)::get(
                this,
                "",
                "vif",
                vif
            )) begin

            `uvm_fatal(
                "NOVIF",
                "Virtual interface not found"
            )

        end

    endfunction

    virtual task run_phase(uvm_phase phase);

        riscv_soc_sequence_item req;

        forever begin

            seq_item_port.get_next_item(req);

            vif.reset <= req.reset;

            @(posedge vif.clock);

            seq_item_port.item_done();

        end

    endtask

endclass
